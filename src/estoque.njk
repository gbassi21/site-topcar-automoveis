---
layout: layouts/base.njk
permalink: /estoque/
titulo: Estoque de seminovos e usados
eleventyComputed:
  descricao: "{{ loja.descricao }} à venda em {{ loja.endereco.cidade }}. Filtre por marca, carroceria, ano, câmbio e preço."
---
{% from "macros.njk" import topoPagina, enderecoLoja %}
{%- set veiculos = collections.veiculos %}
{%- set modoEstoque = true %}

{% call topoPagina({ titulo: "Estoque", lead: loja.descricao + " à venda em " + loja.endereco.cidade + ". Valores de " + loja.valoresEm + ", sujeitos a alteração." }) %}
  <ul class="topo__dados">
    <li>{{ icone("car-front") | safe }}{{ veiculos.length }} {{ "carro" if veiculos.length == 1 else "carros" }} à venda</li>
    <li>{{ icone("map-pin") | safe }}{{ enderecoLoja(loja.endereco.logradouro, loja.abrirNoMaps, loja.abrirNoWaze) }}</li>
    <li>{{ icone("whatsapp") | safe }}<a href="{{ wa(loja.mensagens.geral) }}" target="_blank" rel="noopener">{{ loja.whatsapp.exibicao }}</a></li>
  </ul>
{% endcall %}

<section class="faixa faixa--cinza faixa--estoque" id="carros" aria-label="Carros à venda">
  <div class="envoltorio">
    {% include "partials/vitrine.njk" %}
  </div>
</section>
